# mock: 브라우저 안의 목업 서버만 사용(기본값)
# real: prolog-backend에 있는 API는 실제 서버로, 아직 없는 API(관계·개요 요약 등)는 목업으로 (혼합 모드)
VITE_API_MODE=mock

# real 모드 설정 — 개발 서버가 /v1을 백엔드로 프록시한다(백엔드에 CORS 설정이 없음)
VITE_API_BASE_URL=/v1
VITE_BACKEND_URL=http://localhost:8000
# 원고 업로드 presigned URL을 보낼 로컬 S3(s3mock) 주소
VITE_S3_URL=http://localhost:9000

# Google 로그인 — 백엔드 .env의 GOOGLE_CLIENT_ID와 같은 값.
# 백엔드 GOOGLE_REDIRECT_URI는 이 앱의 /auth/callback 주소(예: http://localhost:5173/auth/callback)로 맞춘다
VITE_GOOGLE_CLIENT_ID=
# VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback
